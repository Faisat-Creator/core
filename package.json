{
  "name": "sorokit-core",
  "version": "0.1.0",
  "description": "Framework-agnostic TypeScript SDK for Stellar wallet connection, transactions, and Soroban contract interaction",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.mjs",
      "require": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/router-swap/tsconfig.json",
    "test": "vitest --run",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist",
    "validate:exports": "node scripts/validate-exports.js"
  },
  "keywords": [
    "stellar",
    "soroban",
    "wallet",
    "blockchain",
    "sdk",
    "typescript"
  ],
  "author": "Sorokit",
  "license": "MIT",
  "peerDependencies": {
    "@creit.tech/stellar-wallets-kit": ">=1.0.0",
    "vitest": ">=1.0.0"
  },
  "devDependencies": {
    "@stellar/stellar-sdk": "^13.3.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^8.57.0",
    "fast-check": "^3.18.0",
    "jsdom": "^24.1.1",
    "msw": "^2.15.0",
    "rimraf": "^5.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "packageManager": "yarn@4.9.4+sha512.7b1cb0b62abba6a537b3a2ce00811a843bea02bcf53138581a6ae5b1bf563f734872bd47de49ce32a9ca9dcaff995aa789577ffb16811da7c603dcf69e73750b"
}
